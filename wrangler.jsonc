// Nitro Pitch on Cloudflare: the game's files (public/) and its online rooms (src/worker.js).
// Cloudflare builds this from GitHub (Workers Builds); "name" must match the Worker's name in the dashboard.
{
  "name": "nitropitch",
  "workers_dev": true,
  "routes": [{ "pattern": "nitropitch.app", "custom_domain": true }],
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Route through the Worker for legacy-domain migration and advertising gating.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Rooms plus short-lived encrypted browser-save transfers between the two domains.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "TRANSFERS", "class_name": "DomainTransfer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["DomainTransfer"] }]
}
