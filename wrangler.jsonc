// Nitro Pitch on Cloudflare: the game's files (public/) and its online rooms (src/worker.js).
// Cloudflare builds this from GitHub (Workers Builds); "name" must match the Worker's name in the dashboard.
{
  "name": "nitropitch",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // the game's files are served straight from Cloudflare's cache; only /ws (online rooms) runs the Worker
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws"] },
  // one Durable Object per room: the lobby, each match, each private match
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
